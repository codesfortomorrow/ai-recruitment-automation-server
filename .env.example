# Core config
PORT=9001
NODE_TYPE=master # {master, cluster}
CLUSTER_WORKERS=2 # NOTE: Only required when NODE_TYPE is cluster & default is 2
NODE_ENV=development # {production, development, test}
LOG_LEVEL=info # {error, warn, info, debug}

# App config
APP_ENV=test # {production, test} NOTE: Only required when NODE_ENV is production
APP_NAME=NestJS App
APP_SHORT_NAME=nestjs-app
DOMAIN=localhost
SERVER_URL=http://localhost:9001
ADMIN_WEB_URL=
APP_WEB_URL=
APP_URI=
# Network-accessible frontend/application URL for HR candidate profile email links
# (Use LAN IP e.g. http://192.168.1.100:9001, frontend port 3000, or public domain instead of localhost)
APP_PUBLIC_URL=

# Metrics
ENABLE_METRICS=false
METRICS_PORT=8080
METRICS_HOST=0.0.0.0

# Storage
STORAGE_DIR=storage
STORAGE_URL=

# Jwt
JWT_SECRET=secret

# Google OAuth2.0 (Only required on production)
GOOGLE_OAUTH_CLIENT_ID=example-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=secret

# Gmail Recruitment Inbox Integration (Google OAuth2 with https://www.googleapis.com/auth/gmail.readonly scope)
GMAIL_USER=me
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Recommended query: filters unread inbox emails that contain PDF or DOCX resume attachments
# Default: label:INBOX is:unread (application-level validation ensures non-resume emails are skipped safely)
GMAIL_SEARCH_QUERY=label:INBOX is:unread has:attachment (filename:pdf OR filename:docx)
GMAIL_POLLING_ENABLED=false
GMAIL_POLLING_CRON=0 * * * * *
GMAIL_MAX_ATTACHMENT_SIZE=10485760 # 10MB

# Google Gemini AI Integration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MAX_RETRIES=2
GEMINI_TIMEOUT_MS=30000
# Gemini Screening Retry & Backoff Configuration
GEMINI_INITIAL_RETRY_DELAY_MS=2000
GEMINI_MAX_RETRY_DELAY_MS=60000
GEMINI_MAX_ATTEMPTS=5
GEMINI_MAX_RETRY_AGE_MS=86400000 # 24 hours
GEMINI_RETRY_WORKER_INTERVAL_MS=10000 # Polling interval for background retry worker
GEMINI_MAX_CONCURRENT_REQUESTS=2 # Max concurrent Gemini screening calls

# Mail (Only required on production)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=example
SMTP_PASSWORD=secret
SMTP_SENDER=info@example.com

# Role-Based HR Assignment Configuration
HR1_ID=hr-1
HR1_NAME=HR 1
HR1_EMAIL=hr1@example.com
HR2_ID=hr-2
HR2_NAME=HR 2
HR2_EMAIL=hr2@example.com
HR_MANUAL_REVIEW_EMAIL=

# Database (Used to establish connection)
DATABASE_URL=postgresql://postgres:secret@postgres:5432/nestjs-app
REDIS_URI=redis://default:secret@redis:6379
MONGO_URI=mongodb://root:secret@mongo:27017/nestjs-app?authSource=admin

# Docker Compose Config
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret

REDIS_PORT=6379
REDISINSIGHT_PORT=8001
REDIS_PASSWORD=secret

MONGO_PORT=27017
MONGO_USER=root
MONGO_PASSWORD=secret

# Docker Volumes (Only required on production)
POSTGRES_DATA_VOLUME=
REDIS_DATA_VOLUME=
MONGO_DATA_VOLUME=
STORAGE_DATA_VOLUME=

# PgAdmin
PGADMIN_PORT=8888
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=secret

# Admin Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_SALT=3ad776bb616579163ca5db27950db2ff
ADMIN_PASSWORD_HASH=ffb3c1f9034a6fc1e5bb82dc8016204b2c03711bd73e6d2e793e3935d6fca924 # {Default Password: Admin123!@#}

# Candidate Excel Persistence (Local Excel candidate persistence)
CANDIDATE_EXCEL_PATH=./data/candidates.xlsx
CANDIDATE_EXCEL_SYNC_INTERVAL_MINUTES=2
CANDIDATE_EXCEL_SYNC_ENABLED=true

# Google Sheets Candidate Persistence
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_KEY_FILE=./config/google-service-account.json
GOOGLE_SHEETS_TAB_NAME=Candidate Tracker
